{
  "name": "@community/dsh-plugin-ade",
  "version": "1.4.3",
  "description": "Hyprland-style drag-to-split multi-pane conversation layout for DeepSeek Harness Desktop.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JessenReinhart/dsh-plugin-ade.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "split-pane",
    "multi-pane",
    "hyprland"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preinstall": "node scripts/build.mjs",
    "test": "node --test src/layout/engine.spec.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
